# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and will NEVER be committed to the repo.

# Plivo credentials (from https://console.plivo.com/dashboard/)
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token

# The Plivo number you were given to call FROM
PLIVO_FROM_NUMBER=+918035454161

# The number to call TO (your own phone, E.164 format)
DEFAULT_TO_NUMBER=+91XXXXXXXXXX

# Placeholder "live associate" number used for the call-forward branch
ASSOCIATE_NUMBER=02264236412

# Hardcoded OTP = your birthdate in DDMM format (e.g. 15 March -> 1503)
OTP_CODE=XXXX

# Publicly reachable base URL for this app (ngrok URL while testing,
# or your deployed URL in production). No trailing slash.
BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Public MP3s played in the Level 2 "play audio" branch
AUDIO_URL_EN=https://s3.amazonaws.com/plivocloud/Trumpet.mp3
AUDIO_URL_ES=https://s3.amazonaws.com/plivocloud/Trumpet.mp3
